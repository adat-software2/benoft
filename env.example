# Copy this file to .env.local (for npm run dev) and fill in the values,
# or add the same variables in your hosting provider's settings.

# SMTP account that sends the lead emails.
# Gmail: smtp.gmail.com, port 465, your Gmail address, and a 16-character App Password
# (Google Account > Security > 2-Step Verification > App passwords). Not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info.benoft@gmail.com
SMTP_PASS=

# Where demo requests are delivered (defaults to info.benoft@gmail.com).
LEAD_TO_EMAIL=info.benoft@gmail.com

# Optional sender address; defaults to SMTP_USER. Gmail only allows your own address here.
LEAD_FROM_EMAIL=
